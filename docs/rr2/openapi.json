  "components": {
    "securitySchemes": {
      "sessionAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "session"
      },
      "ticketOwner": {
        "type": "http",
        "scheme": "bearer",
        "description": "Токен владения из 32 случайных байт, hex; допускает только cancel своего waiting"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "Service": {
        "type": "object",
        "required": [
          "id",
          "prefix",
          "name",
          "active"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "prefix": {
            "type": "string",
            "maxLength": 4
          },
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "active": {
            "type": "boolean"
          }
        }
      },
      "Ticket": {
        "type": "object",
        "required": [
          "id",
          "number",
          "service_id",
          "business_date",
          "seq_no",
          "status",
          "created_at",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "number": {
            "type": "string",
            "maxLength": 32
          },
          "service_id": {
            "type": "integer"
          },
          "window_id": {
            "type": [
              "integer",
              "null"
            ]
          },
          "business_date": {
            "type": "string",
            "format": "date"
          },
          "seq_no": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "waiting",
              "called",
              "in_service",
              "completed",
              "no_show",
              "cancelled"
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "called_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "started_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "finished_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "Metrics": {
        "type": "object",
        "required": [
          "date",
          "issued",
          "completed",
          "no_show",
          "cancelled",
          "mean_wait_minutes"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "issued": {
            "type": "integer",
            "minimum": 0
          },
          "completed": {
            "type": "integer",
            "minimum": 0
          },
          "no_show": {
            "type": "integer",
            "minimum": 0
          },
          "cancelled": {
            "type": "integer",
            "minimum": 0
          },
          "mean_wait_minutes": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "p90_wait_minutes": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    }
  }
}